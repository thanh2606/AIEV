# Copy thành .env rồi điền giá trị (file này KHÔNG bắt buộc nữa)

# Xác thực Claude cho tính năng Chat/AI - chọn MỘT trong hai cách:
#   Cách 1 (khuyên dùng, không cần điền gì): đăng nhập Claude Code trên máy này
#     (VSCode extension hoặc lệnh `claude` -> /login) - hệ thống tự dùng gói subscription.
#   Cách 2: điền API key (tính phí theo usage, lấy tại https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=

# Xác thực Claude thay thế: OAuth token của Claude Code (sinh bằng `claude setup-token`),
# token gateway tương thích Anthropic, hoặc custom proxy/router
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_AUTH_TOKEN=
# URL của proxy/router (OmniRoute, 9router, ...) — trỏ đúng cổng proxy đang chạy
# Khi đặt biến này, hệ thống tự nhận là đã có xác thực Claude, không cần login.
# ANTHROPIC_BASE_URL=http://localhost:3000/v1
# Model Claude mặc định (khi dùng proxy OmniRoute/9router): oc/deepseek-v4-flash-free, oc/hy3-free...
# ANTHROPIC_MODEL=oc/deepseek-v4-flash-free

# Tạo ảnh Gemini (bắt buộc cho Images Project + ảnh minh họa): lấy tại aistudio.google.com/apikey
GEMINI_API_KEY=

# Key Google thay thế cho GEMINI_API_KEY - nếu có CẢ HAI thì GOOGLE_API_KEY thắng
# GOOGLE_API_KEY=

# API key OpenAI (tùy chọn - provider OpenAI ở tab Kết nối)
# OPENAI_API_KEY=

# Số job render song song 1-4 (override tab Cấu hình)
QUEUE_CONCURRENCY=

# Domain Cloudflare Tunnel trỏ về http://localhost:6868 (vd aiev.noti.vn) - QR "Kết nối điện thoại" sẽ dùng domain này
TUNNEL_DOMAIN=

# Ports (mặc định đã đúng, chỉ đổi khi bị trùng)
SERVER_PORT=6869

# Port web UI (mặc định 6868) - dùng cho link/QR "Kết nối điện thoại" và tunnel
# WEB_PORT=

# Đường dẫn Python (máy có nhiều bản Python thì trỏ vào bản đã cài faster-whisper/VieNeu)
# PYTHON_BIN=

# Token xac thuc API - tu sinh khi chay lan dau, ghi vao .env (khong commit)
AIEV_API_TOKEN=

# --- Boc loi (speech-to-text) ---
# Chon AI boc loi cho tung phien Dich video (meta.sttProvider): local | gemini | soniox.
# Mac dinh "local" = faster-whisper large-v3 chay tren may: mien phi, khong can mang,
# nhung KHONG phan biet duoc nguoi noi, va roi ve CPU thi rat cham.
#
# Soniox: boc loi async $0.10/gio, 60+ ngon ngu, PHAN VAI DUOC NGUOI NOI - thu ma buoc
# long tieng can de gan dung giong nam/nu. Lay key tai https://console.soniox.com
# De trong thi provider "soniox" hien la khong dung duoc tren UI (kem ly do), phan con
# lai cua he thong chay binh thuong bang faster-whisper.
SONIOX_API_KEY=

# Provider "gemini" boc loi bang chinh GEMINI_API_KEY o tren - khong can key rieng.
# Luu y: Gemini KHONG tra moc thoi gian tung TU (transcript ghi "words": []).
